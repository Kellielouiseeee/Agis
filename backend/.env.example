# RPC provider (e.g. http://127.0.0.1:8545 or Infura/Alchemy URL)
RPC_URL=http://127.0.0.1:8545

# Expected chain id for safety (optional)
EXPECTED_CHAIN_ID=1

# Deployed contract addresses (set after deploying contracts)
AGISX_ADDRESS=
FEE_ROUTER_ADDRESS=
REWARDS_POOL_ADDRESS=
GAME_ENGINE_ADDRESS=

# Server signing key (DEV only). Use KMS/HSM in production.
SERVER_PRIVATE_KEY=

# Server port (optional)
PORT=4000
